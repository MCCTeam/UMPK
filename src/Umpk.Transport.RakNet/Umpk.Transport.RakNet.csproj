<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>RakNet message transport adapter for UMPK.</Description>
    <IsPackable>false</IsPackable>
    <!-- The Bedrock public surface requires complete XML documentation; CS1591 stays suppressed for legacy projects. -->
    <NoWarn>$(NoWarn.Replace(';CS1591', ''))</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ArkMirage.RakNet" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="../Umpk.Core/Umpk.Core.csproj" />
  </ItemGroup>
</Project>
