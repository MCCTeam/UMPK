<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Fresh checkouts must populate artifacts/bedrock-raknet-feed before restore: run engineering/bedrock/build_raknet.py with source set to a clean RakNet checkout at the revision pinned in data/bedrock/source-manifest.json using the pinned SDK, then dotnet restore. The built .nupkg stays out of Git. -->
  <packageSources>
    <clear />
    <add key="bedrock-raknet" value="artifacts/bedrock-raknet-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
