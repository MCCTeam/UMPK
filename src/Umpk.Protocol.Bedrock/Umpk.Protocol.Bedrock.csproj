<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Minecraft Bedrock protocol identities, framing, codecs, and connection contracts.</Description>
    <IsPackable>false</IsPackable>
    <!-- The Bedrock public surface requires complete XML documentation; CS1591 stays suppressed for legacy projects. -->
    <NoWarn>$(NoWarn.Replace(';CS1591', ''))</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Umpk.Core/Umpk.Core.csproj" />
    <ProjectReference Include="../Umpk.Nbt/Umpk.Nbt.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Umpk.Client.Bedrock" />
    <InternalsVisibleTo Include="Umpk.Client.Bedrock.Tests" />
    <InternalsVisibleTo Include="Umpk.Bedrock.IntegrationTests" />
  </ItemGroup>
</Project>
